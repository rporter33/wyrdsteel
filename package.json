{
  "name": "wyrdsteel",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A browser action RPG of Norse gods rebuilt by machine. A spiritual successor to Too Human.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "size": "node scripts/check-size.mjs",
    "balance": "vitest run --config vitest.balance.config.ts",
    "check": "npm run typecheck && npm test && npm run balance && npm run build && npm run size && npm run e2e"
  },
  "dependencies": {
    "@preact/signals": "2.11.3",
    "preact": "10.29.8",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.19.0",
    "@types/three": "0.186.0",
    "meshoptimizer": "1.3.0",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "vite": "8.3.3",
    "vitest": "4.1.11"
  }
}
